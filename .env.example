# Server-only Supabase PostgreSQL connection. Takes precedence over Turso.
# Copy the Transaction pooler URL from Supabase Connect; encode password characters.
# Keep the real value in Vercel Secrets, never in this file or NEXT_PUBLIC_*.
SUPABASE_DATABASE_URL=

# Legacy Turso rollback configuration, used only if SUPABASE_DATABASE_URL is absent.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Connect a PRIVATE Vercel Blob store to the project. Vercel supplies the token.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Server-only integrations. Never add NEXT_PUBLIC_ to these values.
HQ_WEBHOOK_URL=
HQ_WEBHOOK_SECRET=
HQ_TRANSFER_ENABLED=false
HQ_MAPPING_VERIFIED=false
HQ_PROTOCOL=mapped_bridge
HQ_NOTIFICATION_AUTHORIZED=false
OWNER_EMAIL=tticdlrecruiting@gmail.com

SHIFT_CODE_WEBHOOK_URL=
QUO_WEBHOOK_KEY=
QUO_WEBHOOK_VERSION=2026-03-30
QUO_INGEST_ENABLED=false
INVITED_RECRUITER_SETUP_SECRET=

# Supabase Auth. Workspace records use PostgreSQL when configured above.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Required ONLY by the server-side account provisioning command.
SUPABASE_SERVICE_ROLE_KEY=
# Base64url-encoded random 32-byte key; server only, never NEXT_PUBLIC_.
AUTH_SESSION_ENCRYPTION_KEY=
