# Turso Cloud database. Create/connect it through the Vercel Marketplace.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-auth-token

# Connect a PRIVATE Vercel Blob store to the project. Vercel supplies the token.
BLOB_READ_WRITE_TOKEN=replace-with-vercel-blob-token

# Server-only integrations. Never add NEXT_PUBLIC_ to these values.
HQ_WEBHOOK_URL=
HQ_WEBHOOK_SECRET=
HQ_TRANSFER_ENABLED=false
HQ_MAPPING_VERIFIED=false
HQ_PROTOCOL=mapped_bridge
HQ_NOTIFICATION_AUTHORIZED=false
OWNER_EMAIL=tticdlrecruiting@gmail.com

SHIFT_CODE_WEBHOOK_URL=
QUO_WEBHOOK_KEY=
QUO_WEBHOOK_VERSION=2026-03-30
QUO_INGEST_ENABLED=false
INVITED_RECRUITER_SETUP_SECRET=
